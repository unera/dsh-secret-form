{
  "name": "@dr-co/dsh-secret-form",
  "version": "0.4.0",
  "description": "Secret links in both directions for DeepSeek Harness: the human types a secret into a one-time form, or the model hands one over through a link whose reveal button works exactly once. Durable in SQLite, with file uploads and a note to the session that asked.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale/"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "secret",
    "credentials"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-secret-form.git"
  },
  "homepage": "https://github.com/unera/dsh-secret-form#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-secret-form/issues"
  },
  "author": "Dmitry Oboukhov",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
