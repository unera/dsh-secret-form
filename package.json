{
  "name": "@dr-co/dsh-secret-form",
  "version": "0.2.0",
  "description": "One-time secret links for DeepSeek Harness: the model asks, the human types into a web form, the value lands in the credential store or a file.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "secret",
    "credentials"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-secret-form.git"
  },
  "homepage": "https://github.com/unera/dsh-secret-form#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-secret-form/issues"
  },
  "author": "Dmitry Oboukhov",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
